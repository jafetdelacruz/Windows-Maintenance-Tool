<Configuration>
  <VGpu>Disable</VGpu>
  <Networking>Disable</Networking>
  <AudioInput>Disable</AudioInput>
  <VideoInput>Disable</VideoInput>
  <PrinterRedirection>Disable</PrinterRedirection>
  <ClipboardRedirection>Disable</ClipboardRedirection>
  <MemoryInMB>4096</MemoryInMB>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>C:\Path\To\Windows-Maintenance-Tool\artifacts\release\WinMaint-v1.0.0-rc.4</HostFolder>
      <SandboxFolder>C:\WinMaintCandidate</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>C:\Path\To\Windows-Maintenance-Tool\artifacts\verification\rc4-candidate-inbox</HostFolder>
      <SandboxFolder>C:\WinMaintCandidateOutput</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>powershell.exe -NoProfile -Command "Start-Process -FilePath 'C:\Windows\System32\cmd.exe' -ArgumentList '/c C:\WinMaintCandidate\Run-Rc4-Candidate.cmd' -Verb RunAs"</Command>
  </LogonCommand>
</Configuration>
